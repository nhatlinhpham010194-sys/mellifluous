rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read for music tracks and cover art
    // Allow upload for authors/users
    match /music_tracks/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /music_covers/{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
